<%- include('header') %>
<h2>Költések</h2>
<table>
    <thead>
        <tr>
            <th>Megnevezés</th>
            <th>Összeg</th>
            <th>Kategória</th>
        </tr>
    </thead>
    <tbody>
        <% expenses.forEach(expense => { %>
            <tr class="<%= expense.category %>">
                <td><%= expense.name %></td>
                <td><%= expense.amount %> Ft</td>
                <td><%= expense.category %></td>
            </tr>
        <% }) %>
    </tbody>
</table>
<%- include('footer') %>