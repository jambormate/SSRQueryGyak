<%- include('header') %>
<h2>Statisztikák</h2>
<h3>Összes költés</h3>
<p>Összesen <%= osszesDarab %> db költés volt</p>
<p>Összes összeg: <%= osszesOsszeg %> Ft</p>
<p>Összes átlag: <%= osszesAtlag.toFixed(2) %> Ft</p>
<h3>Kategóriánként</h3>
<table>
    <tr>
        <th>Kategória</th>
        <th>Hány darab</th>
        <th>Összeg</th>
        <th>Átlag</th>
    </tr>
    <% kategoriak.forEach((category, name) => { %>
        <tr>
            <td><%= name %></td>
            <td><%= category.darab %></td>
            <td><%= category.osszeg %> Ft</td>
            <td><%= category.atlag.toFixed(2) %> Ft</td>
        </tr>
    <% }) %>
</table>
<%- include('footer') %>